# ========================================================
# CẤU HÌNH THÔNG TIN XÁC THỰC NEO API (VPBankS)
# ========================================================

# NEO API credentials
NEO_CLIENT_ID=your_neo_client_id_here
NEO_CLIENT_SECRET=your_neo_client_secret_here
NEO_ACCOUNT_NO=your_vpbanks_account_number
NEO_API_BASE_URL=https://neoinvest.vpbanks.com.vn/neo-openapi
NEO_WS_URL=wss://neoinvest.vpbanks.com.vn/neo-openapi/ws

# SSI FASTCONNECT API (Bổ trợ lấy dữ liệu lịch sử & Cross-validation)
SSI_CONSUMER_ID=your_ssi_consumer_id_here
SSI_CONSUMER_SECRET=your_ssi_consumer_secret_here
SSI_API_BASE_URL=https://fc-data.ssi.com.vn

# THIẾT LẬP HỆ THỐNG
TIMEZONE=Asia/Ho_Chi_Minh
DEFAULT_FUTURE_SYMBOL=VN30F1M
DEFAULT_UNDERLYING_SYMBOL=VN30
LOOKBACK_WINDOW_DAYS=20
Z_SCORE_THRESHOLD=2.0
SPREAD_SHOCK_PERCENTILE=95
MAX_REQUESTS_PER_SECOND=5
